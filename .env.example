# ==============================================================================
# Nástěnka – Ukázková konfigurace prostředí (.env.example)
# ==============================================================================
# Zkopírujte tento soubor do .env.local (pro lokální vývoj) nebo do .env (produkce)
# a doplňte skutečné hodnoty.
#
# DŮLEŽITÉ: Nikdy neukládejte skutečné secrets do repozitáře!
# ==============================================================================

# ------------------------------------------------------------------------------
# Prostředí a síť
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Databáze (PostgreSQL 18+)
# Formát: postgresql://<uživatel>:<heslo>@<hostitel>:<port>/<databáze>
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nastenka

# ------------------------------------------------------------------------------
# Autentizace (Better Auth)
# BETTER_AUTH_SECRET: Silný náhodný klíč (minimálně 32 znaků)
# Vygenerujte např. pomocí: openssl rand -base64 32
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=your_minimum_32_characters_random_secret_here
BETTER_AUTH_URL=http://localhost:3000
