# ==============================================================================
# Nástěnka – Vzor produkční konfigurace (.env.production.example)
# ==============================================================================
# Tento soubor slouží jako vzor pro produkční soubor .env na Synology NAS
# (např. v adresáři /docker/App_nastenka/.env).
#
# DŮLEŽITÉ BEZPEČNOSTNÍ PRAVIDLO:
# Skutečné secrets nikdy neukládejte do repozitáře ani do Docker image!
# Skutečný soubor .env na NAS chraňte právy čtení pouze pro vlastníka (chmod 600).
# ==============================================================================

# ------------------------------------------------------------------------------
# Běhové prostředí a síťový port
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# Databáze – Napojení na existující PostgreSQL server na Synology NAS
# Formát: postgresql://<uzivatel>:<heslo>@<hostitel_nebo_IP>:<port>/<databaze>
# Příklad: postgresql://nastenka_user:SilneHeslo123@192.168.0.250:5439/nastenka
# (případně interní IP / hostitel NAS podle konfigurace Docker sítě)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@192.168.0.250:5439/<DB_NAME>

# ------------------------------------------------------------------------------
# Autentizace (Better Auth)
# BETTER_AUTH_SECRET: Minimálně 32 znaků náhodného řetězce
# Vygenerujte např.: openssl rand -base64 32
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=doplnte_minimalne_32_znaku_nahodny_tajny_klic_pro_produkci

# BETTER_AUTH_URL: Přesná URL, pod kterou uživatelé přistupují k aplikaci v LAN
BETTER_AUTH_URL=http://192.168.0.250:3000

# BETTER_AUTH_TRUSTED_ORIGINS: Povolení původu požadavků pro CSRF ochranu
BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.0.250:3000
